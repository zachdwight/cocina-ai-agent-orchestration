<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">Communication Log</h1>
    <p class="text-gray-600">Workflow: <strong><%= @workflow.name || "Untitled" %></strong> (<%= @workflow.workflow_id %>)</p>
  </div>

  <div class="bg-white rounded shadow p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-bold">Messages (<%= @messages.count %>)</h2>
      <a href="<%= workflow_messages_path(@workflow.workflow_id, format: :json) %>" class="text-blue-500 hover:underline text-sm">
        Export JSON
      </a>
    </div>

    <!-- Filters -->
    <div class="mb-6 p-4 bg-gray-50 rounded space-y-3">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <label class="block text-sm font-bold mb-2">Message Type</label>
          <select id="filter-type" class="w-full px-3 py-2 border rounded text-sm">
            <option value="">All Types</option>
            <option value="task.delegated">Task Delegated</option>
            <option value="task.acknowledgment">Task Acknowledgment</option>
            <option value="task.completion">Task Completion</option>
            <option value="task.progress">Task Progress</option>
            <option value="error.notification">Error Notification</option>
            <option value="agent.log_event">Log Event</option>
            <option value="agent.heartbeat">Heartbeat</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-bold mb-2">Status</label>
          <select id="filter-status" class="w-full px-3 py-2 border rounded text-sm">
            <option value="">All Statuses</option>
            <option value="received">Received</option>
            <option value="processed">Processed</option>
            <option value="failed">Failed</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-bold mb-2">Sender</label>
          <select id="filter-sender" class="w-full px-3 py-2 border rounded text-sm">
            <option value="">All Agents</option>
            <% @messages.map(&:sender_agent_id).compact.uniq.each do |agent| %>
              <option value="<%= agent %>"><%= agent %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-bold mb-2">&nbsp;</label>
          <button id="reset-filters" class="w-full px-3 py-2 bg-gray-300 text-gray-700 rounded text-sm hover:bg-gray-400">
            Reset Filters
          </button>
        </div>
      </div>
    </div>

    <!-- Messages -->
    <div class="space-y-3" id="messages-container">
      <% if @messages.any? %>
        <% @messages.each do |msg| %>
          <div class="message-item border-l-4 <%= message_type_border(msg.message_type) %> p-4 bg-gray-50 rounded" data-type="<%= msg.message_type %>" data-status="<%= msg.status %>" data-sender="<%= msg.sender_agent_id %>">
            <div class="flex justify-between items-start mb-3">
              <div>
                <div class="flex items-center gap-3">
                  <span class="px-3 py-1 rounded text-xs font-bold <%= message_type_badge(msg.message_type) %>">
                    <%= msg.message_type.upcase %>
                  </span>
                  <span class="text-xs font-mono text-gray-600"><%= msg.message_id %></span>
                </div>
                <div class="text-xs text-gray-600 mt-2">
                  <% if msg.sender_agent_id %>
                    <strong>From:</strong> <%= msg.sender_agent_id %>
                  <% end %>
                  <% if msg.receiver_agent_id %>
                    | <strong>To:</strong> <%= msg.receiver_agent_id %>
                  <% end %>
                </div>
              </div>
              <div class="text-right">
                <div class="text-xs text-gray-600">
                  <%= msg.created_at.strftime("%b %d, %H:%M:%S") %>
                </div>
                <div class="text-xs font-bold mt-1">
                  <span class="px-2 py-1 rounded <%= status_badge_class(msg.status) %>">
                    <%= msg.status.upcase %>
                  </span>
                </div>
              </div>
            </div>

            <details class="mt-3">
              <summary class="cursor-pointer text-sm font-bold text-blue-600 hover:text-blue-800">
                View Payload
              </summary>
              <div class="mt-2 p-3 bg-white rounded border font-mono text-xs overflow-auto max-h-64">
                <pre><%= JSON.pretty_generate(msg.payload_data) rescue msg.payload %></pre>
              </div>
            </details>

            <% if msg.error_message %>
              <div class="mt-3 p-3 bg-red-50 rounded border border-red-200 text-xs text-red-700">
                <strong>Error:</strong> <%= msg.error_message %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <p>No messages for this workflow yet.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
// Simple message filtering
const filterType = document.getElementById('filter-type');
const filterStatus = document.getElementById('filter-status');
const filterSender = document.getElementById('filter-sender');
const resetBtn = document.getElementById('reset-filters');
const messageItems = document.querySelectorAll('.message-item');

function filterMessages() {
  const type = filterType.value;
  const status = filterStatus.value;
  const sender = filterSender.value;

  messageItems.forEach(item => {
    let show = true;
    if (type && item.getAttribute('data-type') !== type) show = false;
    if (status && item.getAttribute('data-status') !== status) show = false;
    if (sender && item.getAttribute('data-sender') !== sender) show = false;
    item.style.display = show ? '' : 'none';
  });
}

filterType?.addEventListener('change', filterMessages);
filterStatus?.addEventListener('change', filterMessages);
filterSender?.addEventListener('change', filterMessages);

resetBtn?.addEventListener('click', function(e) {
  e.preventDefault();
  filterType.value = '';
  filterStatus.value = '';
  filterSender.value = '';
  filterMessages();
});
</script>

<style>
.message-item[data-type="task.delegated"] {
  border-left-color: #3b82f6; /* blue */
}
.message-item[data-type="task.acknowledgment"] {
  border-left-color: #10b981; /* green */
}
.message-item[data-type="task.completion"] {
  border-left-color: #06b6d4; /* cyan */
}
.message-item[data-type="task.progress"] {
  border-left-color: #f59e0b; /* amber */
}
.message-item[data-type="error.notification"] {
  border-left-color: #ef4444; /* red */
}
.message-item[data-type="agent.log_event"] {
  border-left-color: #8b5cf6; /* purple */
}
</style>
