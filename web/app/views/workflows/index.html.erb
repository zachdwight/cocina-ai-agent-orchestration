<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold">Workflows</h1>
    <%= link_to "New Workflow", new_workflow_path, class: "bg-blue-500 text-white px-4 py-2 rounded" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-white p-4 rounded shadow">
      <div class="text-3xl font-bold text-blue-500"><%= @workflows.total_count %></div>
      <div class="text-gray-600">Total Workflows</div>
    </div>
    <div class="bg-white p-4 rounded shadow">
      <div class="text-3xl font-bold text-yellow-500"><%= @active_workflows %></div>
      <div class="text-gray-600">Active</div>
    </div>
    <div class="bg-white p-4 rounded shadow">
      <div class="text-3xl font-bold text-green-500"><%= @completed_workflows %></div>
      <div class="text-gray-600">Completed</div>
    </div>
  </div>

  <% if @workflows.any? %>
    <div class="bg-white rounded shadow overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-100 border-b">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-bold">Name</th>
            <th class="px-6 py-3 text-left text-sm font-bold">Status</th>
            <th class="px-6 py-3 text-left text-sm font-bold">Progress</th>
            <th class="px-6 py-3 text-left text-sm font-bold">Steps</th>
            <th class="px-6 py-3 text-left text-sm font-bold">Created</th>
            <th class="px-6 py-3 text-left text-sm font-bold">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @workflows.each do |workflow| %>
            <tr class="border-b hover:bg-gray-50">
              <td class="px-6 py-4"><%= workflow.name || "Untitled" %></td>
              <td class="px-6 py-4">
                <span class="px-3 py-1 rounded-full text-sm font-semibold <%= status_badge_class(workflow.status) %>">
                  <%= workflow.status.upcase %>
                </span>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                  <div class="w-32 bg-gray-200 rounded-full h-2">
                    <div class="bg-blue-500 h-2 rounded-full" style="width: <%= workflow.progress_percent %>%"></div>
                  </div>
                  <span class="text-sm"><%= workflow.progress_percent %>%</span>
                </div>
              </td>
              <td class="px-6 py-4"><%= workflow.completed_steps %>/<%= workflow.total_steps %></td>
              <td class="px-6 py-4 text-sm text-gray-600"><%= workflow.created_at.strftime("%b %d, %H:%M") %></td>
              <td class="px-6 py-4">
                <%= link_to "View", workflow_path(workflow.workflow_id), class: "text-blue-500 hover:underline" %>
                <% if workflow.pending? %>
                  | <%= link_to "Start", start_workflow_path(workflow.workflow_id), method: :post, class: "text-green-500 hover:underline" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <%= paginate @workflows %>
    </div>
  <% else %>
    <div class="bg-white rounded shadow p-8 text-center">
      <p class="text-gray-500 mb-4">No workflows yet.</p>
      <%= link_to "Create your first workflow", new_workflow_path, class: "text-blue-500 hover:underline" %>
    </div>
  <% end %>
</div>
